# copy to .env and fill
BOT_TOKEN=123456:AA-from-BotFather
ALLOWED_USER_IDS=360053442
DEVICE_SERIAL=192.168.1.50:5555
# Lock-screen PIN typed on wake (Tailscale requires a device lock).
#DEVICE_PIN=1234
DB_PATH=/var/lib/asbot/places.db

# polling (default): no public endpoint needed.
# webhook: set MODE=webhook + WEBHOOK_BASE_URL + WEBHOOK_PORT,
#          requires public HTTPS (Cloudflare Tunnel / Tailscale Funnel).
MODE=polling
#WEBHOOK_BASE_URL=https://asbot.your-domain.com
#WEBHOOK_PORT=8080
